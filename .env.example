# Server Configuration
PORT=5000
NODE_ENV=development
# Origen(es) permitidos para CORS (separados por coma si son varios).
# En desarrollo local: usar http://localhost:3000, http://localhost:5173 o *
# En produccion: cambiar al dominio de frontend en Vercel (ej. https://tu-front.vercel.app)
CORS_ORIGIN=http://localhost:3000

# Supabase Configuration
# Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
